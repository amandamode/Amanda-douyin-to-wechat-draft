# ─────────────────────────────────────────────────────────────────────
#  微信公众号开发凭证 —— 配置模板
#
#  用法：
#    1. 复制本文件到技能包之外，例如  ~/.workbuddy/secrets/wechat-mp.env
#    2. 填入真实值
#    3. 推送脚本默认就读这个路径；也可用 --env / 环境变量覆盖
#
#  ⚠️ 本文件只含占位符，可以公开。
#     填了真实值的副本【切勿】提交到任何仓库或上传到技能市场。
# ─────────────────────────────────────────────────────────────────────

# 【必填】公众号 AppID
#   获取路径：公众号后台 → 设置与开发 → 开发管理 → 开发接口管理 → 基本配置
#   形如 wx + 16 位十六进制
WECHAT_APPID=wx0000000000000000

# 【必填】公众号 AppSecret
#   同一页面点「重置」后可见，只显示一次，务必立刻保存
WECHAT_SECRET=your-app-secret-here

# 【可选】微信 API 基地址
#   默认 https://api.weixin.qq.com，一般不需要改。
#   走企业代理 / 内网网关 / 私有镜像时才需要覆盖。
#   生效优先级：--api-base 命令行 > 环境变量 WECHAT_API_BASE > 本文件 > 默认值
WECHAT_API_BASE=https://api.weixin.qq.com

# 【可选】公众号名称，仅用于日志标注，不参与接口调用
WECHAT_ACCOUNT=你的公众号名称

# ── 补充：Docker / CI 里不落盘的做法 ─────────────────────────────────
#   直接用环境变量注入，脚本同样识别：
#     export WECHAT_APPID=wx...
#     export WECHAT_SECRET=...
#     export WECHAT_API_BASE=https://api.weixin.qq.com
